# Public deployment settings only; passwords belong in secrets/.
XSYNC_SERVER_IMAGE=xsync-server:local
XSYNC_PROXY_NETWORK=xsync-proxy
# Required: Nginx's fixed IP on that network, with /32 for IPv4 or /128 for IPv6.
# For multiple explicitly trusted proxies, separate their CIDRs with commas.
XSYNC_TRUSTED_PROXIES=
